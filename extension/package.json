{
  "name": "obmctweaks",
  "version": "1.0.0",
  "description": "A browser extension used to customize OrangeApps.",

  "dependencies": {
    "bootstrap": "^5.3.8"
  },

  "devDependencies": {
    "cpx2": "^7.0.0"
  },
  
  "scripts": {
    "postinstall": "npm run copy-bootstrap",
    "copy-bootstrap": "cpx \"node_modules/bootstrap/dist/**/*\" libs/bootstrap/dist && cpx \"node_modules/bootstrap/scss/**/*\" libs/bootstrap/scss"
  }
}