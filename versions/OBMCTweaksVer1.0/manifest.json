{
	"name": "OBMC Tweaks",

	"description": "Customize the O.B. Digital Platform the way YOU want to!",
	"version": "1.0",
	"manifest_version": 3,

	"icons": {
		"16": "images/extension-logo-16.png",
		"32": "images/extension-logo-32.png",
		"48": "images/extension-logo-48.png",
		"128": "images/extension-logo-128.png"
	},

	"action": {
		"default_icon": "images/extension-logo.png"
	},

	"background": {
		"service_worker": "scripts/main/background.js"
	},

	"content_scripts": [
		{
			"js": ["scripts/main/customize.js"],
			"matches": ["https://obmontessorilaspinas.orangeapps.ph/*"],
			"run_at": "document_end"
		}
	],

	"permissions": [
		"activeTab",
		"scripting",
		"tabs",
		"storage",
		"notifications"
	],

	"host_permissions": [
		"https://obmontessorilaspinas.orangeapps.ph/*",
		"https://www.youtube.com/embed/jfKfPfyJRdk?autoplay=1",
		"https://samirpaulb.github.io/music/embed"
	],

	"web_accessible_resources": [
		{
			"resources": [
				"scripts/helper/*",
				"images/*"
			],
			"matches": ["<all_urls>"]
		}
	]
}